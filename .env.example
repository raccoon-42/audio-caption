# Copy to .env and fill in. .env is gitignored (it holds real secrets).
# Scripts auto-load .env via python-dotenv, so `uv run python ...` picks these up.

# DashScope / Alibaba Model Studio -- Qwen3-Omni captioner reference row.
# Get the key from the Model Studio console -> API-KEY. Singapore/intl by default.
DASHSCOPE_API_KEY=
# Leave blank for Singapore/intl (default). Set only for another region, e.g.
# Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# OpenRouter -- LLM-as-judge panel (Gemini 2.5, gpt-audio, Claude Opus 4.8,
# Llama 4). Not yet wired; placeholder for the upcoming judge harness.
OPENROUTER_API_KEY=
