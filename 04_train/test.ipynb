        "# Batched versions for efficient GPU utilization\n",
        "def get_audio_embeddings_batch(samples):\n",
        "    \"\"\"Process multiple audio samples in batch\"\"\"\n",
        "    audios = []\n",
        "    for sample in samples:\n",
        "        audio = sample[\"audio\"][\"array\"]\n",
        "        sr = sample[\"audio\"][\"sampling_rate\"]\n",
        "        \n",
        "        if audio.ndim == 2:\n",
        "            audio = audio.mean(axis=1)\n",
        "        \n",
        "        if sr != 48000:\n",
        "            audio = librosa.resample(audio, orig_sr=sr, target_sr=48000)\n",
        "        \n",
        "        audios.append(audio)\n",
        "    \n",
        "    inputs = clap_processor(\n",
        "        audios=audios,\n",
        "        sampling_rate=48000,\n",
        "        return_tensors=\"pt\"\n",
        "    ).to(device)\n",
        "    \n",
        "    with torch.no_grad():\n",
        "        embs = clap.get_audio_features(**inputs)\n",
        "    \n",
        "    return embs  # (B, D_AUDIO)\n",
        "\n",
        "def train_step_batch(samples):\n",
        "    \"\"\"Process a batch of samples - MUCH faster on GPU!\"\"\"\n",
        "    B = len(samples)\n",
        "    \n",
        "    # Get audio embeddings for batch\n",
        "    audio_embs = get_audio_embeddings_batch(samples)  # (B, D_AUDIO)\n",
        "    \n",
        "    # Projection → prefix tokens\n",
        "    prefix = projection(audio_embs)  # (B, PREFIX_LEN * D_LM)\n",
        "    prefix = prefix.view(B, PREFIX_LEN, D_LM)  # (B, PREFIX_LEN, D_LM)\n",
        "    \n",
        "    # Tokenize all captions\n",
        "    captions = [s[\"caption\"] for s in samples]\n",
        "    tokens = tokenizer(\n",
        "        captions,\n",
        "        return_tensors=\"pt\",\n",
        "        padding=True,\n",
        "        truncation=True,\n",
        "        max_length=128\n",
        "    ).to(device)\n",
        "    \n",
        "    input_ids = tokens.input_ids  # (B, T)\n",
        "    \n",
        "    # Text embeddings\n",
        "    text_embeds = gpt2.transformer.wte(input_ids)  # (B, T, D_LM)\n",
        "    \n",
        "    # Concatenate prefix + text\n",
        "    inputs_embeds = torch.cat([prefix, text_embeds], dim=1)  # (B, PREFIX_LEN + T, D_LM)\n",
        "    \n",
        "    # Labels (ignore prefix)\n",
        "    labels = input_ids.clone()  # (B, T)\n",
        "    ignore = torch.full((B, PREFIX_LEN), -100, device=device)\n",
        "    labels = torch.cat([ignore, labels], dim=1)  # (B, PREFIX_LEN + T)\n",
        "    \n",
        "    outputs = gpt2(\n",
        "        inputs_embeds=inputs_embeds,\n",
        "        labels=labels\n",
        "    )\n",
        "    \n",
        "    return outputs.loss"
      ]
