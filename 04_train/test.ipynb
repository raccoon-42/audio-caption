      "source": [
        "projection = nn.Sequential(\n",
        "    nn.Linear(D_AUDIO, D_LM * 2),      # 512 → 1536\n",
        "    nn.GELU(),\n",
        "    nn.Dropout(0.2),\n",
        "    nn.Linear(D_LM * 2, D_LM * 4),     # 1536 → 3072\n",
        "    nn.GELU(),\n",
        "    nn.Dropout(0.2),\n",
        "    nn.Linear(D_LM * 4, PREFIX_LEN * D_LM),  # 3072 → PREFIX_LEN * 768\n",
        ").to(device)\n",
        "projection.train()"
      ]
    },
